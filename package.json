{
  "name": "wp-astrojs-integration",
  "version": "0.6.0",
  "description": "Astro integration for WordPress with live loaders, server actions, auth helpers, catalog support, and Gutenberg components",
  "keywords": [
    "astro",
    "astro-integration",
    "cms",
    "gutenberg",
    "headless",
    "wordpress",
    "wp-api"
  ],
  "homepage": "https://github.com/JUVOJustin/astrojs-wp-integration#readme",
  "bugs": {
    "url": "https://github.com/JUVOJustin/astrojs-wp-integration/issues"
  },
  "license": "MIT",
  "author": "juvojustin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JUVOJustin/astrojs-wp-integration.git"
  },
  "files": [
    "dist",
    "src/components"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js"
    },
    "./components": {
      "import": "./src/components/index.ts"
    },
    "./components/WPImage.astro": {
      "import": "./src/components/WPImage.astro"
    },
    "./components/WPContent.astro": {
      "import": "./src/components/WPContent.astro"
    },
    "./loaders": {
      "types": "./dist/loaders/index.d.ts",
      "import": "./dist/loaders/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "pnpm run build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "pnpm run test:integration && pnpm run test:build",
    "test:integration": "varlock run -- node tooling/run-tests.mjs --project integration",
    "test:build": "varlock run -- node tooling/run-tests.mjs --project static-build",
    "test:watch": "varlock run -- vitest --project integration --project static-build",
    "wp:start": "wp-env start",
    "wp:stop": "wp-env stop",
    "wp:clean": "wp-env clean all",
    "wp:status": "wp-env status",
    "preinstall": "npx only-allow pnpm",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "check:astro": "eslint --config tooling/astro-eslint.config.mjs \"src/**/*.astro\" \"tests/fixtures/**/*.astro\" && prettier --ignore-path tooling/astro.prettierignore --config tooling/astro-prettier.config.mjs --check \"src/**/*.astro\" \"tests/fixtures/**/*.astro\"",
    "fix:astro": "eslint --config tooling/astro-eslint.config.mjs --fix \"src/**/*.astro\" \"tests/fixtures/**/*.astro\" && prettier --ignore-path tooling/astro.prettierignore --config tooling/astro-prettier.config.mjs --write \"src/**/*.astro\" \"tests/fixtures/**/*.astro\"",
    "ultracite:refresh": "ultracite init --pm pnpm --linter oxlint --agents universal --yes --quiet && ultracite fix oxlint.config.ts oxfmt.config.ts",
    "check:types": "astro check --tsconfig tsconfig.json"
  },
  "dependencies": {
    "devalue": "^6.0.3",
    "vite": "^8.3.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.2",
    "@astrojs/node": "^11.1.11",
    "@emnapi/runtime": "^1.11.3",
    "@types/node": "^24.19.2",
    "@wordpress/env": "^12.1.0",
    "astro": "^7.4.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "fluent-wp-client": "^3.1.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "ultracite": "8.1.1",
    "varlock": "^1.24.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "astro": "^7.4.7",
    "fluent-wp-client": "^3.1.0"
  },
  "engines": {
    "node": "^22.23.4 || >=24.15.0"
  },
  "packageManager": "pnpm@12.16.1"
}
